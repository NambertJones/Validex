# Validex Local Development Configuration Example
APP_NAME=Validex
ENVIRONMENT=development
DEBUG=true

# Database (Use SQLite for zero-setup local dev, or PostgreSQL)
DATABASE_URL=sqlite:///./validex.db
# DATABASE_URL=postgresql://aicte:aicte_secret@localhost:5432/aicte_validation

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO or Local Fallback)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret
MINIO_BUCKET=aicte-documents
MINIO_SECURE=false

# Security & JWT
SECRET_KEY=dev-secret-key-validex-aicte-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
