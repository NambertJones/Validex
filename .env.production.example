# Validex Production Environment Configuration
APP_NAME=Validex
ENVIRONMENT=production
DEBUG=false

# Database
POSTGRES_USER=aicte
POSTGRES_PASSWORD=replace_with_strong_password_32_chars
POSTGRES_DB=aicte_validation
DATABASE_URL=postgresql://aicte:replace_with_strong_password_32_chars@postgres:5432/aicte_validation

# Celery & Cache
REDIS_URL=redis://redis:6379/0

# Storage (MinIO or AWS S3)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key
MINIO_BUCKET=aicte-documents
MINIO_SECURE=false

# Security & JWT
SECRET_KEY=generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS (Domain where your frontend runs)
CORS_ORIGINS=https://validex.yourdomain.com,http://localhost:3000
